{
  "title": "gatekeeper",
  "uid": "gatekeeper",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (route, code) (rate(gateway_requests_total[1m]))", "legendFormat": "{{route}} {{code}}" }
      ]
    },
    {
      "id": 2,
      "title": "Request duration p50 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, route) (rate(gateway_request_duration_seconds_bucket[1m])))", "legendFormat": "p50 {{route}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, route) (rate(gateway_request_duration_seconds_bucket[1m])))", "legendFormat": "p99 {{route}}" }
      ]
    },
    {
      "id": 3,
      "title": "Upstream target health",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "gateway_upstream_healthy", "legendFormat": "{{upstream}} {{target}}" }
      ]
    },
    {
      "id": 4,
      "title": "Circuit breaker state (0=closed 1=open 2=half_open)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "gateway_circuit_state", "legendFormat": "{{upstream}}" }
      ]
    },
    {
      "id": 5,
      "title": "Rate limit rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (route) (rate(gateway_ratelimit_rejected_total[1m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 6,
      "title": "Retries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (upstream) (rate(gateway_retries_total[1m]))", "legendFormat": "{{upstream}}" }
      ]
    },
    {
      "id": 7,
      "title": "Active connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "gateway_active_connections", "legendFormat": "{{upstream}}" }
      ]
    }
  ]
}
